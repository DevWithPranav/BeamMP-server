TS_AUTHKEY=tskey-auth-your-ephemeral-or-reusable-key
TS_HOSTNAME=beammp-ubuntu
BEAMMP_AUTH_KEY=your-beammp-auth-key
BEAMMP_NAME=Private BeamMP Server
BEAMMP_DESCRIPTION=BeamMP server on Ubuntu over Tailscale
BEAMMP_PRIVATE=true
BEAMMP_PORT=30814
BEAMMP_MAP=/levels/gridmap_v2/info.json
BEAMMP_MAX_PLAYERS=8
BEAMMP_MAX_CARS=2
BEAMMP_TAGS=Freeroam,Private
BEAMMP_ALLOW_GUESTS=true
BEAMMP_LOG_CHAT=false
BEAMMP_VERSION=v3.9.3
BEAMMP_ASSET=BeamMP-Server.ubuntu.24.04.x86_64

