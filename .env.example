TS_AUTHKEY=tskey-auth-your-ephemeral-or-reusable-key
TS_HOSTNAME=beammp-ubuntu
BEAMMP_AUTH_KEY=your-beammp-auth-key
BEAMMP_NAME=Private BeamMP Server
BEAMMP_DESCRIPTION=BeamMP server on Ubuntu over Tailscale
BEAMMP_PRIVATE=true
BEAMMP_PORT=30814
BEAMMP_MAP=/levels/DangerousRoads2/info.json
BEAMMP_MAX_PLAYERS=8
BEAMMP_MAX_CARS=2
BEAMMP_TAGS=Freeroam,Private
BEAMMP_ALLOW_GUESTS=true
BEAMMP_LOG_CHAT=false
BEAMMP_VERSION=v3.9.3
BEAMMP_ASSET=BeamMP-Server.ubuntu.24.04.x86_64
# Scheduling priority for BeamMP-Server (-20 highest .. 19 lowest).
BEAMMP_NICE=-5
# ServerTools plugin: comma-separated BeamMP account names allowed to /kick, /ban, /say.
BEAMMP_ADMINS=
BEAMMP_WELCOME=Welcome! Type /help for commands.
# Seconds between [stats] log lines (0 disables).
BEAMMP_STATS_INTERVAL=60
# Optional: only used by `docker compose --profile monitoring up -d`.
# Discord webhook URL to post crash/health alerts to. Leave blank to disable.
DISCORD_WEBHOOK_URL=

# Stats reporter (monitoring profile): sample period and Discord summary period.
STATS_SAMPLE_SECONDS=60
STATS_REPORT_MINUTES=60
